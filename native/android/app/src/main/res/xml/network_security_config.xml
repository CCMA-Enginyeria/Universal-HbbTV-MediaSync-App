<?xml version="1.0" encoding="utf-8"?>
<!--
  Televisions are addressed by LAN IP over HTTP/WS, so cleartext cannot be
  limited by domain. Endpoint schemes and hosts are validated in the core.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
